{
  "name": "@weifxn/react-native-ink",
  "version": "0.1.0",
  "description": "React Native's components and APIs for terminal apps and CLIs, rendered with Ink.",
  "keywords": [
    "react-native",
    "react",
    "ink",
    "cli",
    "terminal",
    "tui",
    "console",
    "command-line"
  ],
  "homepage": "https://github.com/weifxn/react-native-ink#readme",
  "bugs": {
    "url": "https://github.com/weifxn/react-native-ink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weifxn/react-native-ink.git"
  },
  "license": "MIT",
  "author": "weifxn (https://github.com/weifxn)",
  "contributors": [
    "Evan Bacon (https://github.com/evanbacon)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:compat": "tsx scripts/generate-compat.ts",
    "example": "node scripts/example.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "ink": "^8.0.0",
    "jpeg-js": ">=0.4.0",
    "pngjs": ">=7.0.0",
    "react": ">=19.3.0"
  },
  "peerDependenciesMeta": {
    "jpeg-js": {
      "optional": true
    },
    "pngjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-native/normalize-colors": "^0.88.1",
    "chalk": "^6.0.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
